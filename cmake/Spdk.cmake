# SPDK's library graph changes between releases (rdma vs rdma_provider/utils,
# DPDK components, optional ISA-L, etc.). Consume the graph generated by the
# selected build instead of maintaining a second static library list here.
include_guard(GLOBAL)

function(mooncake_configure_spdk)
  if(TARGET Mooncake::spdk)
    return()
  endif()

  set(SPDK_ROOT_DIR
      ""
      CACHE PATH "Configured and built SPDK source directory")
  set(SPDK_LIB_DIR
      "/usr/local/lib"
      CACHE PATH "SPDK library directory")
  set(DPDK_LIB_DIR
      "/usr/local/lib"
      CACHE PATH "DPDK library directory")
  set(SPDK_PKG_CONFIG_DIR
      ""
      CACHE PATH "Directory containing SPDK .pc files")

  if(SPDK_ROOT_DIR)
    get_filename_component(_root "${SPDK_ROOT_DIR}" REALPATH)
    set(_pc_dir "${_root}/build/lib/pkgconfig")
    if(NOT EXISTS "${_root}/mk/config.mk")
      message(
        FATAL_ERROR
          "SPDK_ROOT_DIR=${_root} is not configured. Run SPDK ./configure --with-rdma and make first."
      )
    endif()
    file(STRINGS "${_root}/mk/config.mk" _rdma_config
         REGEX "^CONFIG_RDMA[?+:]?=[ \t]*y[ \t]*$")
    if(NOT _rdma_config)
      message(
        FATAL_ERROR
          "SPDK at ${_root} was configured without RDMA. Reconfigure it with --with-rdma and rebuild before enabling USE_NOF."
      )
    endif()
    if(SPDK_PKG_CONFIG_DIR)
      get_filename_component(_explicit_pc "${SPDK_PKG_CONFIG_DIR}" REALPATH)
      get_filename_component(_root_pc "${_pc_dir}" REALPATH)
      if(NOT _explicit_pc STREQUAL _root_pc)
        message(
          FATAL_ERROR
            "SPDK_ROOT_DIR and SPDK_PKG_CONFIG_DIR select different builds. Use only one selection."
        )
      endif()
    endif()
  elseif(SPDK_PKG_CONFIG_DIR)
    set(_pc_dir "${SPDK_PKG_CONFIG_DIR}")
  else()
    # Preserve the existing SPDK_LIB_DIR build option for installed SPDK.
    set(_pc_dir "${SPDK_LIB_DIR}/pkgconfig")
  endif()
  get_filename_component(_pc_dir "${_pc_dir}" ABSOLUTE)
  if(NOT EXISTS "${_pc_dir}/spdk_nvme.pc")
    message(
      FATAL_ERROR
        "Missing ${_pc_dir}/spdk_nvme.pc. Complete the SPDK build/install, or set SPDK_ROOT_DIR / SPDK_PKG_CONFIG_DIR to the correct build."
    )
  endif()

  find_package(PkgConfig REQUIRED)
  set(_pkg_path "${_pc_dir}:${DPDK_LIB_DIR}/pkgconfig:$ENV{PKG_CONFIG_PATH}")
  # Local variables and execute_process avoid FindPkgConfig's cached results
  # selecting the previous SPDK when a build directory is reconfigured.
  set(_pkg_command "${CMAKE_COMMAND}" -E env "PKG_CONFIG_PATH=${_pkg_path}"
                   "${PKG_CONFIG_EXECUTABLE}")
  set(_packages spdk_nvme spdk_env_dpdk spdk_sock_posix spdk_syslibs)
  execute_process(
    COMMAND ${_pkg_command} --libs --static ${_packages}
    RESULT_VARIABLE _result
    OUTPUT_VARIABLE _libs
    ERROR_VARIABLE _error
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT _result EQUAL 0)
    message(
      FATAL_ERROR
        "Cannot read complete SPDK dependencies from ${_pc_dir}:\n${_error}\nRun the full SPDK make (and make install for an installed prefix). Do not mix .pc files or archives from different builds."
    )
  endif()

  # A missing dependency in the chosen directory must not be silently filled by
  # an old SPDK installation found through the system pkg-config path.
  set(_pending ${_packages})
  set(_seen)
  get_filename_component(_pc_real "${_pc_dir}" REALPATH)
  while(_pending)
    list(POP_FRONT _pending _package)
    if(_package IN_LIST _seen)
      continue()
    endif()
    list(APPEND _seen "${_package}")
    execute_process(
      COMMAND ${_pkg_command} --variable=pcfiledir "${_package}"
      RESULT_VARIABLE _result
      OUTPUT_VARIABLE _origin
      OUTPUT_STRIP_TRAILING_WHITESPACE)
    get_filename_component(_origin "${_origin}" REALPATH)
    if(NOT _result EQUAL 0 OR NOT _origin STREQUAL _pc_real)
      message(
        FATAL_ERROR
          "SPDK dependency ${_package} comes from ${_origin}, not ${_pc_real}. Complete the selected SPDK build; mixed SPDK versions are unsupported."
      )
    endif()
    execute_process(
      COMMAND ${_pkg_command} --print-requires --print-requires-private
              "${_package}"
      RESULT_VARIABLE _result
      OUTPUT_VARIABLE _requires)
    if(NOT _result EQUAL 0)
      message(FATAL_ERROR "Cannot inspect SPDK dependency ${_package}")
    endif()
    string(REGEX MATCHALL "spdk_[A-Za-z0-9_]+" _deps "${_requires}")
    list(APPEND _pending ${_deps})
  endwhile()
  if(NOT "spdk_rdma" IN_LIST _seen AND NOT "spdk_rdma_provider" IN_LIST _seen)
    message(
      FATAL_ERROR
        "Selected spdk_nvme has no RDMA transport dependency. Build SPDK with --with-rdma and regenerate its .pc files."
    )
  endif()

  execute_process(
    COMMAND ${_pkg_command} --cflags ${_packages}
    RESULT_VARIABLE _result
    OUTPUT_VARIABLE _cflags
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Cannot read SPDK compiler flags")
  endif()
  separate_arguments(_cflags UNIX_COMMAND "${_cflags}")
  set(_includes)
  set(_compile_options)
  foreach(_flag IN LISTS _cflags)
    if(_flag MATCHES "^-I(.+)$")
      list(APPEND _includes "${CMAKE_MATCH_1}")
    else()
      list(APPEND _compile_options "${_flag}")
    endif()
  endforeach()

  separate_arguments(_libs UNIX_COMMAND "${_libs}")
  set(_library_dirs)
  foreach(_flag IN LISTS _libs)
    if(_flag MATCHES "^-L(.+)$")
      list(APPEND _library_dirs "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  set(_archives)
  set(_system_libs)
  foreach(_flag IN LISTS _libs)
    if(_flag MATCHES "^-l((spdk_|rte_).+)$")
      set(_name "${CMAKE_MATCH_1}")
      set(_archive "")
      foreach(_dir IN LISTS _library_dirs)
        if(EXISTS "${_dir}/lib${_name}.a")
          set(_archive "${_dir}/lib${_name}.a")
          break()
        endif()
      endforeach()
      if(NOT _archive)
        message(
          FATAL_ERROR
            "Missing lib${_name}.a required by ${_pc_dir}. Complete the SPDK/DPDK static build. Searched: ${_library_dirs}"
        )
      endif()
      list(APPEND _archives "${_archive}")
    else()
      list(APPEND _system_libs "${_flag}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _archives)

  # Some installed SPDK spdk_syslibs.pc files omit these even though the RDMA
  # archives need them. Declare the mandatory RDMA system dependencies here.
  # Absolute library paths also avoid confusing these with an earlier -l flag
  # pulled in by Transfer Engine when the linker uses --as-needed.
  find_library(
    MOONCAKE_SPDK_RDMACM_LIBRARY
    NAMES rdmacm
    HINTS ${_library_dirs})
  find_library(
    MOONCAKE_SPDK_IBVERBS_LIBRARY
    NAMES ibverbs
    HINTS ${_library_dirs})
  if(NOT MOONCAKE_SPDK_RDMACM_LIBRARY OR NOT MOONCAKE_SPDK_IBVERBS_LIBRARY)
    message(
      FATAL_ERROR
        "NoF requires librdmacm and libibverbs development libraries. Install the RDMA development packages or set MOONCAKE_SPDK_RDMACM_LIBRARY and MOONCAKE_SPDK_IBVERBS_LIBRARY to the matching libraries."
    )
  endif()
  list(APPEND _system_libs ${MOONCAKE_SPDK_RDMACM_LIBRARY}
       ${MOONCAKE_SPDK_IBVERBS_LIBRARY})

  # Compile against the selected headers before compiling all Store objects. Use
  # a static try-compile: no SPDK environment or hardware is initialized.
  include(CheckCXXSourceCompiles)
  set(CMAKE_REQUIRED_INCLUDES ${_includes})
  string(JOIN " " CMAKE_REQUIRED_FLAGS ${_compile_options})
  set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
  unset(MOONCAKE_SPDK_API_COMPATIBLE CACHE)
  check_cxx_source_compiles(
    "
#include <spdk/env.h>
#include <spdk/dma.h>
#include <spdk/nvme.h>
int main() {
  spdk_nvme_ctrlr_opts ctrlr{};
  ctrlr.src_addr[0] = 0;
  spdk_nvme_ns_cmd_ext_io_opts io{};
  io.size = sizeof(io);
  io.memory_domain = nullptr;
  spdk_memory_domain_rdma_ctx rdma{};
  rdma.ibv_pd = nullptr;
  auto readv = &spdk_nvme_ns_cmd_readv_ext;
  auto writev = &spdk_nvme_ns_cmd_writev_ext;
  auto domains = &spdk_nvme_ctrlr_get_memory_domains;
  auto translate = &spdk_memory_domain_set_translation;
  (void)ctrlr; (void)io; (void)rdma;
  (void)readv; (void)writev; (void)domains; (void)translate;
  return 0;
}
"
    MOONCAKE_SPDK_API_COMPATIBLE)
  if(NOT MOONCAKE_SPDK_API_COMPATIBLE)
    message(
      FATAL_ERROR
        "Selected SPDK headers do not provide Mooncake's required NVMe/translation APIs. Inspect CMake's configure log; do not mix installed headers with source-build libraries."
    )
  endif()

  add_library(Mooncake::spdk INTERFACE IMPORTED GLOBAL)
  set_target_properties(
    Mooncake::spdk PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_includes}"
                              INTERFACE_COMPILE_OPTIONS "${_compile_options}")
  # SPDK transports and DPDK drivers register through constructors. Retain them
  # even if the application does not directly reference a symbol in each one.
  # The group also resolves circular dependencies between static libraries.
  target_link_libraries(
    Mooncake::spdk
    INTERFACE -Wl,--start-group -Wl,--whole-archive ${_archives}
              -Wl,--no-whole-archive ${_system_libs} -Wl,--end-group)
  message(STATUS "NoF SPDK dependencies: ${_pc_dir}")
  message(STATUS "NoF SPDK RDMA packages: ${_seen}")
endfunction()
